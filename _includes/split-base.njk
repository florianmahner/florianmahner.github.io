<!DOCTYPE html>
<html lang="en" data-bg="{{ site.background or 'none' }}" data-intro="{{ site.intro or 'none' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.fullName }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.fullName }}">
  {# A dev-only lab page: never let it compete with the homepage. #}
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ site.url }}/">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="theme-color" content="#eeeff1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)">
  <link rel="preload" href="/fonts/inter-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
  <script>
    // .js gates everything that hides content until JS shows it; .split-motion
    // additionally gates the reveal start states, so reduced-motion readers
    // (and no-JS readers) get the plain, fully visible page.
    (function (r) {
      r.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('split-motion');
    })(document.documentElement);
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/split.css">
  <script src="/js/motion.js" defer></script>
  <script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.min.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"}}</script>
  <script>
    // Text effects and the 3D stage load after the page, so first paint never waits on them.
    addEventListener('load', function () {
      var m = document.createElement('script');
      m.type = 'module';
      m.src = '/js/split/main.js';
      document.head.appendChild(m);
    });
  </script>
</head>
<body>
{{ content | safe }}

<script>
  // Show/hide toggles: older news, all publications (same logic as base.njk).
  // Opening a panel tells js/split/ about it, because hidden content can't be
  // measured: its lines are split and observed only once it is shown.
  function bindToggle(btn, panel, openLabel, closedLabel) {
    if (!btn || !panel) return;
    btn.addEventListener('click', function() {
      var open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.textContent = open ? openLabel : closedLabel;
      document.dispatchEvent(new CustomEvent('split:expand', { detail: { panel: panel, open: open } }));
    });
  }
  (function() {
    bindToggle(document.getElementById('toggle-news'), document.getElementById('news-older'), 'show less', 'show older');
    var pubBtn = document.getElementById('toggle-publications');
    if (pubBtn) bindToggle(pubBtn, document.getElementById('all-publications'), 'Show selected only', pubBtn.textContent);
  })();
</script>
</body>
</html>
