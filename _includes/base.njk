<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.fullName }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}">
  <meta property="og:title" content="{{ title or site.fullName }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="twitter:card" content="summary">
  <meta property="twitter:title" content="{{ title or site.fullName }}">
  <meta property="twitter:description" content="{{ description or site.description }}">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <meta name="theme-color" content="#ffffff">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="page">
  <header>
    <nav class="nav">
      <ul class="nav-links">
        <li><a href="/#about" data-nav="about">About</a></li>
        <li><a href="/#background" data-nav="background">Background</a></li>
        <li><a href="/#publications" data-nav="publications">Publications</a></li>
        <li><a href="/#code" data-nav="code">Code</a></li>
      </ul>
    </nav>
  </header>

  <button class="mobile-nav-toggle" aria-label="Open menu" aria-expanded="false">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="4" y1="8" x2="20" y2="8"></line>
      <line x1="4" y1="16" x2="20" y2="16"></line>
    </svg>
  </button>
  <div class="mobile-nav-overlay"></div>
  <div class="mobile-nav-panel">
    <button class="mobile-nav-close" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <ul class="mobile-nav-links">
      <li><a href="/#about" class="mobile-nav-link">About</a></li>
      <li><a href="/#background" class="mobile-nav-link">Background</a></li>
      <li><a href="/#publications" class="mobile-nav-link">Publications</a></li>
      <li><a href="/#code" class="mobile-nav-link">Code</a></li>
    </ul>
  </div>

  {{ content | safe }}

  <footer class="footer">
    <div class="footer-left">&copy; {% year %} {{ site.fullName }}</div>
    <div class="footer-right">
      <a href="mailto:{{ site.email }}">Email</a>
      {% if site.social.github %}<a href="https://github.com/{{ site.social.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>{% endif %}
      {% if site.social.linkedin %}<a href="https://www.linkedin.com/in/{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>{% endif %}
    </div>
  </footer>
</div>

<script>
  // Mobile nav
  const toggle = document.querySelector('.mobile-nav-toggle');
  const overlay = document.querySelector('.mobile-nav-overlay');
  const panel = document.querySelector('.mobile-nav-panel');
  const closeBtn = document.querySelector('.mobile-nav-close');

  function openNav() {
    panel.classList.add('open');
    overlay.classList.add('visible');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeNav() {
    panel.classList.remove('open');
    overlay.classList.remove('visible');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (toggle) toggle.addEventListener('click', openNav);
  if (closeBtn) closeBtn.addEventListener('click', closeNav);
  if (overlay) overlay.addEventListener('click', closeNav);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeNav(); });
  document.querySelectorAll('.mobile-nav-link').forEach(function(link) {
    link.addEventListener('click', closeNav);
  });

  // Scroll reveal
  (function() {
    var els = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function(el) { el.classList.add('visible'); });
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    els.forEach(function(el) { observer.observe(el); });
  })();

  // Active nav link
  (function() {
    var sections = document.querySelectorAll('section[id]');
    var navLinks = document.querySelectorAll('[data-nav]');
    if (!sections.length || !navLinks.length) return;
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var id = entry.target.getAttribute('id');
          navLinks.forEach(function(link) {
            link.classList.toggle('active', link.getAttribute('data-nav') === id);
          });
        }
      });
    }, { rootMargin: '-40% 0px -60% 0px' });
    sections.forEach(function(s) { obs.observe(s); });
  })();

  // Expand/collapse publications
  (function() {
    var btn = document.getElementById('toggle-publications');
    var section = document.getElementById('all-publications');
    if (!btn || !section) return;
    btn.addEventListener('click', function() {
      var isHidden = section.hidden;
      if (isHidden) {
        section.hidden = false;
        section.style.opacity = '0';
        requestAnimationFrame(function() {
          section.style.transition = 'opacity 0.3s ease';
          section.style.opacity = '1';
        });
      } else {
        section.style.transition = 'opacity 0.2s ease';
        section.style.opacity = '0';
        section.addEventListener('transitionend', function handler() {
          section.hidden = true;
          section.style.opacity = '';
          section.style.transition = '';
          section.removeEventListener('transitionend', handler);
        });
      }
      btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      btn.textContent = isHidden ? 'Show less \u2191' : 'View all publications \u2193';
    });
  })();
</script>
</body>
</html>
