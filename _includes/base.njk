<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.fullName }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.fullName }}">
  {% if site.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.googleSiteVerification }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.fullName }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.fullName }}">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.fullName }}">
  <meta name="twitter:description" content="{{ description or site.description }}">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="theme-color" content="#eeeff1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#141417" media="(prefers-color-scheme: dark)">
  <link rel="preload" href="/fonts/inter-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
  <script>document.documentElement.classList.add('js')</script>
  <link rel="stylesheet" href="/css/style.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfilePage",
        "@id": "{{ site.url }}/#profile",
        "url": "{{ site.url }}/",
        "name": {{ (title or site.fullName) | dump | safe }},
        "description": {{ (description or site.description) | dump | safe }},
        "mainEntity": { "@id": "{{ site.url }}/#person" },
        "isPartOf": { "@id": "{{ site.url }}/#website" }
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": {{ site.fullName | dump | safe }},
        "givenName": {{ site.name.first | dump | safe }},
        "familyName": {{ site.name.last | dump | safe }},
        "url": "{{ site.url }}/",
        "email": "mailto:{{ site.email }}",
        "jobTitle": {{ site.title | dump | safe }},
        "description": {{ site.description | dump | safe }},
        {% if site.affiliations and site.affiliations.length %}"affiliation": [
          {%- for affiliation in site.affiliations %}
          {
            "@type": {{ (affiliation.type or "Organization") | dump | safe }},
            "name": {{ affiliation.name | dump | safe }},
            {% if affiliation.alternateName %}"alternateName": {{ affiliation.alternateName | dump | safe }},{% endif %}
            "url": {{ affiliation.url | dump | safe }}{% if affiliation.department %},
            "department": {
              "@type": "Organization",
              "name": {{ affiliation.department.name | dump | safe }},
              "url": {{ affiliation.department.url | dump | safe }}
            }{% endif %}
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ],{% endif %}
        "knowsAbout": [
          "Computational Neuroscience",
          "Deep Learning",
          "Representational Alignment",
          "Human Vision",
          "Neural Networks",
          "Cognitive Science"
        ],
        "sameAs": [
          {%- set parts = [] -%}
          {%- if site.social.github -%}{%- set _ = parts.push("https://github.com/" + site.social.github) -%}{%- endif -%}
          {%- if site.social.linkedin -%}{%- set _ = parts.push("https://www.linkedin.com/in/" + site.social.linkedin) -%}{%- endif -%}
          {%- if site.social.scholar -%}{%- set _ = parts.push(site.social.scholar) -%}{%- endif -%}
          {%- if site.social.orcid -%}{%- set _ = parts.push("https://orcid.org/" + site.social.orcid) -%}{%- endif -%}
          {%- if site.social.twitter -%}{%- set _ = parts.push("https://twitter.com/" + site.social.twitter) -%}{%- endif -%}
          {%- for link in parts -%}{{ link | dump | safe }}{% if not loop.last %},{% endif %}{%- endfor -%}
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "name": {{ site.fullName | dump | safe }},
        "alternateName": "florianmahner.com",
        "url": "{{ site.url }}/",
        "publisher": { "@id": "{{ site.url }}/#person" }
      }
    ]
  }
  </script>

  {% if publications %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Publications by {{ site.fullName }}",
    "itemListElement": [
      {%- for pub in publications -%}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "item": {
          "@type": "ScholarlyArticle",
          "headline": {{ pub.title | dump | safe }},
          "name": {{ pub.title | dump | safe }},
          "author": [{%- for a in pub.authors -%}{ "@type": "Person", "name": {{ a | dump | safe }} }{% if not loop.last %},{% endif %}{%- endfor -%}],
          "datePublished": "{{ pub.year }}"{% if pub.venue %},
          "publication": {{ pub.venue | dump | safe }}{% endif %}{% if pub.html %},
          "url": {{ pub.html | dump | safe }}{% endif %}{% if pub.description %},
          "abstract": {{ pub.description | dump | safe }}{% endif %},
          "creator": { "@type": "Person", "name": "{{ site.fullName }}" }
        }
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ]
  }
  </script>
  {% endif %}
</head>
<body>
{{ content | safe }}

<script>
  // Scroll reveal — content is visible without JS (the .js class gates it).
  (function() {
    var els = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function(el) { el.classList.add('visible'); });
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach(function(el) { observer.observe(el); });
  })();

  // Show/hide toggles: older news, all publications.
  function bindToggle(btn, panel, openLabel, closedLabel) {
    if (!btn || !panel) return;
    btn.addEventListener('click', function() {
      var open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.textContent = open ? openLabel : closedLabel;
      if (open) panel.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
    });
  }
  (function() {
    var newsBtn = document.querySelector('.news-more');
    bindToggle(newsBtn, document.getElementById('news-older'), 'Show less', 'Show older');
    var pubBtn = document.getElementById('toggle-publications');
    if (pubBtn) bindToggle(pubBtn, document.getElementById('all-publications'), 'Show selected only', pubBtn.textContent);
  })();

  // Living dot grid — the background dots flow toward the cursor and swirl
  // around it (a soft point attractor), then spring back. Desktop pointers
  // only; touch devices and reduced-motion readers keep the static CSS dots.
  (function() {
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!fine.matches || calm.matches) return;

    var canvas = document.createElement('canvas');
    canvas.className = 'dot-field';
    canvas.setAttribute('aria-hidden', 'true');
    document.body.prepend(canvas);
    document.documentElement.classList.add('dots-live');
    var ctx = canvas.getContext('2d');

    var GAP = 16, SIGMA = 120, PULL = 0.32, SWIRL = 0.22, BASE_R = 1;
    var w = 0, h = 0, dpr = 1, dotColor = '', accent = '';
    var mouse = { x: -1e4, y: -1e4 }, eased = { x: -1e4, y: -1e4 };
    var strength = 0, target = 0, running = false, t0 = performance.now();

    function readColors() {
      var cs = getComputedStyle(document.documentElement);
      dotColor = cs.getPropertyValue('--dots').trim() || 'rgba(17,17,17,.08)';
      accent = cs.getPropertyValue('--accent').trim() || '#7c3aed';
    }
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(performance.now());
    }

    function draw(now) {
      ctx.clearRect(0, 0, w, h);
      var oy = -(window.scrollY % GAP);         // dots scroll with the page
      var mx = eased.x, my = eased.y, reach = SIGMA * 3;
      var s2 = 2 * SIGMA * SIGMA, k = strength;
      var swirl = SWIRL * (0.75 + 0.25 * Math.sin((now - t0) / 1400));
      var hot = [];

      ctx.fillStyle = dotColor;
      ctx.beginPath();
      for (var y = GAP / 2 + oy; y < h + GAP; y += GAP) {
        for (var x = GAP / 2; x < w + GAP; x += GAP) {
          var dx = mx - x, dy = my - y;
          if (k > 0.001 && dx < reach && dx > -reach && dy < reach && dy > -reach) {
            var f = k * Math.exp(-(dx * dx + dy * dy) / s2);
            if (f > 0.002) {
              var px = x + PULL * f * dx - swirl * f * dy;
              var py = y + PULL * f * dy + swirl * f * dx;
              if (f > 0.12) { hot.push(px, py, f); continue; }
              ctx.moveTo(px + BASE_R, py); ctx.arc(px, py, BASE_R + f, 0, 6.2832);
              continue;
            }
          }
          ctx.moveTo(x + BASE_R, y); ctx.arc(x, y, BASE_R, 0, 6.2832);
        }
      }
      ctx.fill();

      if (hot.length) {
        ctx.fillStyle = accent;
        for (var i = 0; i < hot.length; i += 3) {
          ctx.globalAlpha = Math.min(1, hot[i + 2] * 0.9);
          ctx.beginPath();
          ctx.arc(hot[i], hot[i + 1], BASE_R + hot[i + 2] * 1.3, 0, 6.2832);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
    }

    function tick(now) {
      eased.x += (mouse.x - eased.x) * 0.12;
      eased.y += (mouse.y - eased.y) * 0.12;
      strength += (target - strength) * 0.06;
      draw(now);
      var moving = Math.abs(mouse.x - eased.x) + Math.abs(mouse.y - eased.y) > 0.3;
      if (moving || Math.abs(target - strength) > 0.002 || strength > 0.002) {
        requestAnimationFrame(tick);
      } else {
        running = false;
      }
    }
    function wake() { if (!running) { running = true; requestAnimationFrame(tick); } }

    window.addEventListener('pointermove', function(e) {
      if (e.pointerType && e.pointerType !== 'mouse') return;
      if (strength < 0.01) { eased.x = e.clientX; eased.y = e.clientY; }
      mouse.x = e.clientX; mouse.y = e.clientY; target = 1; wake();
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', function() { target = 0; wake(); });
    window.addEventListener('blur', function() { target = 0; wake(); });
    window.addEventListener('scroll', function() { if (!running) draw(performance.now()); }, { passive: true });
    window.addEventListener('resize', resize);
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() { readColors(); draw(performance.now()); });

    readColors();
    resize();
  })();

  // Hero accent dot — physics-driven bounce. CSS keyframes can only lerp
  // between samples (visible kinks at apex/contact); a per-frame integrator
  // gives a genuinely parabolic trajectory.
  (function() {
    var dot = document.querySelector('.hero-name .accent-dot');
    if (!dot) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var fs = parseFloat(getComputedStyle(dot).fontSize);
    if (!fs || isNaN(fs)) return;

    var H0 = 1.2 * fs;             // initial drop height (above rest)
    var X0 = 0.5 * fs;             // initial horizontal offset
    var e  = 0.8;                  // coefficient of restitution
    var g  = 36 * fs;              // gravity, px/s^2

    var t1 = Math.sqrt(2 * H0 / g);
    var T  = t1 * (1 + 2 * e / (1 - e));
    var vx = -X0 / T;

    var x = X0, height = H0, vy = 0, startTime = null, lastTime = null;

    function apply() {
      dot.style.transform = 'translate(' + x.toFixed(2) + 'px, ' + (-height).toFixed(2) + 'px)';
    }
    function step(now) {
      if (startTime === null) { startTime = now; lastTime = now; }
      var dt = Math.min(0.032, (now - lastTime) / 1000);
      lastTime = now;
      var elapsed = (now - startTime) / 1000;
      vy -= g * dt;
      height += vy * dt;
      x += vx * dt;
      if (height < 0) { height = 0; vy = -vy * e; }
      if (elapsed < T && (height > 0.1 || Math.abs(vy) > 2 || Math.abs(x) > 0.1)) {
        apply();
        requestAnimationFrame(step);
      } else {
        dot.style.transform = '';
      }
    }
    apply();
    setTimeout(function() { requestAnimationFrame(step); }, 400);
  })();
</script>
</body>
</html>
