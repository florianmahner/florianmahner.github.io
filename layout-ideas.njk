{% macro newsList(items) %}
<p class="nl-label mono">news.log</p>
{% for item in items %}<p class="ni"><i class="o {{ ['clay','steel','ink','clay','steel'][loop.index0 % 5] }}"></i><strong>{{ item.date | monthName }} {{ item.date | yearOf }}:</strong> {{ item.text | newsText | safe }}</p>{% endfor %}
{% endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Layout ideas</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/css/style.css">
<style>
  body { padding: 2.5rem var(--gutter) 4rem; }
  h1 { font-size: var(--fs-heading); font-weight: 700; letter-spacing: -.03em; margin-bottom: .4rem; }
  .lede { color: var(--muted); margin-bottom: 2rem; max-width: 48rem; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 2rem; }
  .cap { font-family: var(--mono); font-size: var(--fs-mono); color: var(--quiet); margin-bottom: .5rem; }
  .cap b { color: var(--ink); font-weight: 500; }
  .about { margin-top: .6rem; font-size: var(--fs-small); color: var(--muted); }
  /* each frame is a real 1440 x 900 desktop screen, scaled down */
  .shot { position: relative; width: 100%; aspect-ratio: 1440 / 900; overflow: hidden; border: var(--border); }
  .board { position: absolute; left: 0; top: 0; width: 1440px; height: 900px; transform-origin: 0 0; transform: scale(var(--k, .46));
    background: var(--bg); background-image: radial-gradient(var(--dots) 1px, transparent 1.2px); background-size: 16px 16px; padding: 0 58px; }
  .hdr { position: absolute; left: 58px; top: 18px; font-weight: 700; font-size: var(--fs-body); }
  .research p { font-size: var(--fs-lead); font-weight: 500; line-height: 1.45; letter-spacing: -.01em; color: var(--ink); }
  .research p + p { margin-top: 1.2rem; }
  .research p:first-child { display: none; } /* the first paragraph lives on the first screen */
  .nl-label { color: var(--quiet); margin-bottom: 1rem; padding-left: 3.4rem; }
  .ni { position: relative; font-size: var(--fs-small); line-height: 1.55; padding-left: 3.4rem; margin-bottom: 1.1rem; }
  .ni strong { color: var(--strong); }
  .o { position: absolute; left: .7rem; top: .1rem; width: 30px; height: 30px; border-radius: 50%; }
  .o.clay { background: radial-gradient(circle at 35% 30%, #fff, #ecebe7 45%, #c6c5c1 100%); }
  .o.steel { background: radial-gradient(circle at 35% 30%, #e8eef9, #b2c1d9 50%, #8495b2 100%); }
  .o.ink { background: radial-gradient(circle at 35% 30%, #6b6b73, #2a2a2e 50%, #0e0e10 100%); }
  .fade { -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent); mask-image: linear-gradient(to bottom, #000 80%, transparent); overflow: hidden; }

  /* 0 — now: three columns */
  .L0 .wrap { position: absolute; left: 58px; right: 58px; top: 170px; display: grid; grid-template-columns: 1fr 1fr 23rem; gap: 3rem; }
  .L0 .research { grid-column: span 2; columns: 2; column-gap: 3rem; }
  .L0 .research p { break-inside: avoid; }
  .L0 .news { max-height: 560px; }

  /* 1 — two calm columns: research stacked left, news right with room */
  .L1 .wrap { position: absolute; left: 58px; right: 58px; top: 150px; display: grid; grid-template-columns: minmax(0, 40rem) minmax(0, 28rem); justify-content: space-between; }
  .L1 .news { max-height: 600px; }

  /* 2 — research above in two columns, news as a row underneath */
  .L2 .research { position: absolute; left: 58px; right: 58px; top: 130px; columns: 2; column-gap: 4rem; }
  .L2 .research p { break-inside: avoid; }
  .L2 .row { position: absolute; left: 58px; right: 58px; top: 560px; }
  .L2 .row .items { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .L2 .row .ni { padding-left: 0; padding-top: 2.6rem; }
  .L2 .row .o { left: 0; top: 0; }
  .L2 .nl-label { padding-left: 0; }

  /* 3 — news gets its own screen */
  .pair.L3 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .L3 .shot { aspect-ratio: 1440 / 900; }
  .L3 .research { position: absolute; left: 58px; right: 58px; top: 220px; columns: 2; column-gap: 4rem; }
  .L3 .research p { break-inside: avoid; }
  .L3 .solo { position: absolute; left: 50%; top: 150px; width: 40rem; transform: translateX(-50%); }
  .L3 .solo .ni { font-size: var(--fs-body); }
</style>
</head>
<body>
<h1>Second screen: arrangements</h1>
<p class="lede">Your real text at desktop size (1440 × 900), scaled down. The round markers stand in for the 3D objects that line up beside the news.</p>

<div class="grid2">
  <div>
    <p class="cap"><b>Now</b> · three columns</p>
    <div class="shot L0"><div class="board"><p class="hdr">Florian P. Mahner</p>
      <div class="wrap">
        <div class="research">{% mdfile "about" %}</div>
        <div class="news fade">{{ newsList(news.slice(0, 5)) }}</div>
      </div></div></div>
    <p class="about">For comparison: three narrow columns, dense.</p>
  </div>

  <div>
    <p class="cap"><b>1</b> · two calm columns</p>
    <div class="shot L1"><div class="board"><p class="hdr">Florian P. Mahner</p>
      <div class="wrap">
        <div class="research">{% mdfile "about" %}</div>
        <div class="news fade">{{ newsList(news.slice(0, 5)) }}</div>
      </div></div></div>
    <p class="about">Your research text in one column on the left, news.log on the right with more room. One reading line per side.</p>
  </div>

  <div>
    <p class="cap"><b>2</b> · research above, news as a row</p>
    <div class="shot L2"><div class="board"><p class="hdr">Florian P. Mahner</p>
      <div class="research">{% mdfile "about" %}</div>
      <div class="row"><p class="nl-label mono">news.log</p><div class="items">
        {% for item in news.slice(0, 4) %}<p class="ni"><i class="o {{ ['clay','steel','ink','clay'][loop.index0] }}"></i><strong>{{ item.date | monthName }} {{ item.date | yearOf }}:</strong> {{ item.text | newsText | safe }}</p>{% endfor %}
      </div></div></div></div>
    <p class="about">Research in two columns on top; the four newest news items side by side underneath, each with its object above it. Older ones slide in sideways.</p>
  </div>

  <div>
    <p class="cap"><b>3</b> · news gets its own screen</p>
    <div class="pair L3">
      <div class="shot"><div class="board" style="--k:.225"><p class="hdr">Florian P. Mahner</p><div class="research">{% mdfile "about" %}</div></div></div>
      <div class="shot"><div class="board" style="--k:.225"><p class="hdr">Florian P. Mahner</p><div class="solo">{{ newsList(news.slice(0, 5)) }}</div></div></div>
    </div>
    <p class="about">Research gets a screen of its own (two columns), then news.log gets the next screen, centred, at body size, with the objects lining up beside it.</p>
  </div>
</div>
<script>
  // keep each scaled board filling its frame
  const fit = () => document.querySelectorAll('.shot').forEach(s => s.querySelector('.board').style.setProperty('--k', (s.clientWidth / 1440).toFixed(4)));
  addEventListener('resize', fit); fit();
</script>
</body>
</html>
