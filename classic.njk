---
title: Florian P. Mahner
---
{% import "classic-pub.njk" as card %}
{% import "icons.njk" as icons %}

<main class="page" id="top">

  <div class="name-row">
    <h1 class="hero-name reveal" id="name">Florian P<span class="accent-dot">.</span> Mahner</h1>
    <div class="name-links">{{ icons.socialIcons(site) }}</div>
  </div>

  <div class="grid hero">
    <section class="span-8 about reveal" aria-labelledby="name">
      {% mdfile "about" %}
    </section>

    {% if news and news.length %}
    <aside class="news span-4 reveal" aria-labelledby="news-heading">
      <h2 class="news-heading" id="news-heading">News</h2>
      {# all news in one list that scrolls inside the card; each entry is the
         month in a narrow column and the text beside it #}
      <div class="news-list" tabindex="0">
        {%- set last = "" -%}
        {%- for item in news -%}
        {%- set y = item.date | yearOf -%}
        {%- if y != last %}
        <p class="news-year mono">{{ y }}</p>{% set last = y %}{% endif %}
        <p class="news-item"><span class="news-when mono">{{ item.date | monthName | truncate(3, true, "") }}</span><span>{{ item.text | newsText | safe }}</span></p>
        {%- endfor %}
      </div>
    </aside>
    {% endif %}
  </div>

  {# the selected three, then under "show more" the other journal papers;
     conference papers are left to Google Scholar #}
  <section class="grid block" aria-labelledby="publications-heading">
    <h2 class="block-heading span-12" id="publications-heading">Selected publications</h2>
    {# one sideways row: the selected three, and after "show more" the other
       journal papers join it. Without JavaScript all of them are in the row. #}
    <div class="pub-row" id="cards" aria-label="Publications">
      {% for pub in publications %}{% if pub.selected %}{{ card.pubCard(pub, site.highlightAuthor, pub.art, false) }}{% endif %}{% endfor %}
      {% for pub in publications %}{% if not pub.selected and not pub.conference %}{{ card.pubCard(pub, site.highlightAuthor, pub.art, true) }}{% endif %}{% endfor %}
    </div>
    <p class="block-foot span-12 mono">
      <span class="foot-links"><button class="text-button" id="more-button" type="button" aria-expanded="true" aria-controls="cards" hidden>show less</button>
      {% if site.social.scholar %}<a class="pub-scholar" href="{{ site.social.scholar }}" target="_blank" rel="noopener noreferrer">Google Scholar</a>{% endif %}</span>
      <span>* equal contribution</span>
    </p>
  </section>

  {# Background: one window, one row per position #}
  <section class="grid block" aria-labelledby="background-heading">
    <h2 class="block-heading span-12" id="background-heading">Background</h2>
    <ul class="edu-table span-12 reveal">
      {% for edu in education %}
      <li class="edu-row">
        <p class="edu-years mono">{% if edu.startLabel %}{{ edu.startLabel }}{% else %}{{ edu.startYear }}–{{ edu.endYear }}{% endif %}</p>
        <h3 class="edu-degree">{{ edu.degree }} {{ edu.field }}</h3>
        <p class="edu-meta">{% if edu.group %}<a href="{{ edu.groupUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.group }}</a>, {% endif %}<a href="{{ edu.institutionUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.institution }}</a>{% if edu.institution2 %} and <a href="{{ edu.institution2Url }}" target="_blank" rel="noopener noreferrer">{{ edu.institution2 }}</a>{% endif %}</p>
      </li>
      {% endfor %}
    </ul>
  </section>

  <footer class="footer">
    <p class="mono">&copy; {% year %} {{ site.fullName }}</p>
  </footer>
</main>
