---
import BaseLayout from '../layouts/BaseLayout.astro';
import repos from '../content/repositories.json';
import { config } from '../config';

const title = `Open Source | ${config.site.title}`;

// Sort by stars (highest first)
const sortedRepos = [...repos.repositories].sort((a, b) => (b.stars || 0) - (a.stars || 0));
---

<BaseLayout title={title} description="Open source tools and libraries">
  <article class="opensource-page">
    <div class="container">
      <header class="page-header" data-animate="fade-up">
        <h1>Open Source</h1>
      </header>

      <section class="repos-grid" data-animate="stagger">
        {sortedRepos.map(repo => (
          <a href={repo.url} class="repo-card" target="_blank" rel="noopener noreferrer">
            <div class="repo-name">{repo.name}</div>
            <div class="repo-desc">{repo.description}</div>
            <div class="repo-footer">
              <span class="lang"><span class="dot" data-lang={repo.language?.toLowerCase()}></span>{repo.language}</span>
              <span class="stats">
                {repo.stars > 0 && <span class="stat"><svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/></svg>{repo.stars}</span>}
                {repo.forks > 0 && <span class="stat"><svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>{repo.forks}</span>}
              </span>
            </div>
          </a>
        ))}
      </section>

      <p class="view-all" data-animate="fade">
        <a href={`https://github.com/${repos.github_user}`} target="_blank" rel="noopener noreferrer">
          View all on GitHub &rarr;
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .opensource-page {
    padding: var(--space-8) 0;
  }

  .repos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .repo-card {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .repo-card:hover {
    border-color: var(--color-text-muted);
  }

  .repo-name {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    margin-bottom: var(--space-1);
    transition: color var(--transition-fast);
  }

  .repo-card:hover .repo-name {
    color: var(--color-accent);
  }

  .repo-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
    margin-bottom: var(--space-3);
  }

  .repo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3572A5;
  }

  .stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
  }

  .stat svg {
    opacity: 0.5;
  }

  @media (max-width: 550px) {
    .repos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
