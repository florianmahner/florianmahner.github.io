---
import BaseLayout from '../layouts/BaseLayout.astro';
import repos from '../content/repositories.json';
import { config } from '../config';

const title = `Open Source | ${config.site.title}`;

// Sort by stars (highest first)
const sortedRepos = [...repos.repositories].sort((a, b) => (b.stars || 0) - (a.stars || 0));

// Language colors
const langColors: Record<string, string> = {
  python: '#3572A5',
  javascript: '#f1e05a',
  typescript: '#3178c6',
  rust: '#dea584',
  go: '#00ADD8',
  java: '#b07219',
  c: '#555555',
  'c++': '#f34b7d',
  ruby: '#701516',
  shell: '#89e051',
};
---

<BaseLayout title={title} description="Open source tools and libraries">
  <article class="opensource-page">
    <div class="container">
      <header class="page-header" data-animate="fade-up">
        <h1>Open Source</h1>
      </header>

      <div class="repos-list" data-animate="stagger">
        {sortedRepos.map(repo => (
          <a href={repo.url} class="repo-row" target="_blank" rel="noopener noreferrer">
            <span class="repo-name">{repo.name}</span>
            <span class="repo-desc">{repo.description}</span>
            <span class="repo-meta">
              {repo.language && (
                <span class="repo-lang">
                  <span class="lang-dot" style={`background: ${langColors[repo.language.toLowerCase()] || '#666'}`}></span>
                  {repo.language}
                </span>
              )}
              {repo.stars > 0 && <span class="repo-stat">{repo.stars}</span>}
            </span>
          </a>
        ))}
      </div>

      <p class="view-all" data-animate="fade">
        <a href={`https://github.com/${repos.github_user}`} target="_blank" rel="noopener noreferrer">
          View all on GitHub &rarr;
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .repos-list {
    display: flex;
    flex-direction: column;
  }

  .repo-row {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    margin: 0 calc(-1 * var(--space-4));
    border-radius: var(--radius-md);
    text-decoration: none;
    background: none;
    transition: background-color var(--transition-fast);
  }

  .repo-row:hover {
    background-color: var(--color-bg-alt);
  }

  .repo-name {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .repo-row:hover .repo-name {
    color: var(--color-accent);
  }

  .repo-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .repo-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .repo-lang {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .repo-stat {
    font-family: var(--font-mono);
    min-width: 2ch;
    text-align: right;
  }

  @media (max-width: 640px) {
    .repo-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding: var(--space-4);
    }

    .repo-desc {
      white-space: normal;
      overflow: visible;
    }

    .repo-meta {
      margin-top: var(--space-2);
    }
  }
</style>
