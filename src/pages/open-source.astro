---
import BaseLayout from '../layouts/BaseLayout.astro';
import repos from '../content/repositories.json';
import { config } from '../config';

const title = `Open Source | ${config.site.title}`;

// Sort by stars (highest first)
const sortedRepos = [...repos.repositories].sort((a, b) => (b.stars || 0) - (a.stars || 0));

// Language colors (GitHub style)
const langColors: Record<string, string> = {
  python: '#3572A5',
  javascript: '#f1e05a',
  typescript: '#3178c6',
  rust: '#dea584',
  go: '#00ADD8',
  java: '#b07219',
  c: '#555555',
  'c++': '#f34b7d',
  ruby: '#701516',
  shell: '#89e051',
};
---

<BaseLayout title={title} description="Open source tools and libraries">
  <article class="opensource-page">
    <div class="container">
      <header class="page-header" data-animate="fade-up">
        <h1>Open Source</h1>
      </header>

      <div class="repos-list" data-animate="stagger">
        {sortedRepos.map(repo => (
          <a href={repo.url} class="repo-card" target="_blank" rel="noopener noreferrer">
            <div class="repo-content">
              <div class="repo-header">
                <span class="repo-name">{repo.name}</span>
                {repo.language && (
                  <span class="repo-lang">
                    <span class="lang-dot" style={`background: ${langColors[repo.language.toLowerCase()] || '#666'}`}></span>
                    {repo.language}
                  </span>
                )}
              </div>
              <p class="repo-desc">{repo.description}</p>
              <div class="repo-stats">
                {repo.stars > 0 && (
                  <span class="stat">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                      <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/>
                    </svg>
                    {repo.stars}
                  </span>
                )}
                {repo.forks > 0 && (
                  <span class="stat">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                      <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/>
                    </svg>
                    {repo.forks}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

      <p class="view-all" data-animate="fade">
        <a href={`https://github.com/${repos.github_user}`} target="_blank" rel="noopener noreferrer">
          View all on GitHub &rarr;
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  /* Vertical list like publications */
  .repos-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .repo-card {
    display: block;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    background: none;
    transition: background-color var(--transition-fast);
  }

  .repo-card:hover {
    background-color: var(--color-bg-alt);
  }

  .repo-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .repo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .repo-name {
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .repo-card:hover .repo-name {
    color: var(--color-accent);
  }

  .repo-lang {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .repo-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
    margin: 0;
  }

  .repo-stats {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .stat svg {
    opacity: 0.6;
  }

  @media (max-width: 500px) {
    .repo-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
  }
</style>
