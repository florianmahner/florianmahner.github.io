---
import BaseLayout from '../layouts/BaseLayout.astro';
import repos from '../content/repositories.json';
import { config } from '../config';

const title = `Open Source | ${config.site.title}`;

// Sort by stars (highest first)
const sortedRepos = [...repos.repositories].sort((a, b) => (b.stars || 0) - (a.stars || 0));
---

<BaseLayout title={title} description="Open source tools and libraries">
  <article class="opensource-page">
    <div class="container">
      <header class="page-header" data-animate="fade-up">
        <h1>Open Source</h1>
        <p class="page-intro">Tools and libraries I've built or contributed to.</p>
      </header>

      <div class="projects" data-animate="stagger">
        {sortedRepos.map((repo, index) => (
          <a href={repo.url} class="project" target="_blank" rel="noopener noreferrer" style={`--delay: ${index * 50}ms`}>
            <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
            <div class="project-info">
              <h2 class="project-name">{repo.name}</h2>
              <p class="project-desc">{repo.description}</p>
            </div>
            <span class="project-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 17L17 7M17 7H7M17 7V17"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <footer class="page-footer" data-animate="fade">
        <a href={`https://github.com/${repos.github_user}`} class="github-link" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View all repositories
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header h1 {
    margin-bottom: var(--space-3);
  }

  .page-intro {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Projects as elegant numbered list */
  .projects {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .project {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    background: none;
    transition: all var(--transition-fast);
    animation: fadeIn 0.4s ease backwards;
    animation-delay: var(--delay);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project:hover {
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    margin-left: calc(-1 * var(--space-4));
    margin-right: calc(-1 * var(--space-4));
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-md);
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-light);
  }

  .project-info {
    min-width: 0;
  }

  .project-name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-normal);
    color: var(--color-text);
    margin: 0 0 var(--space-1) 0;
    transition: color var(--transition-fast);
  }

  .project:hover .project-name {
    color: var(--color-accent);
  }

  .project-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--line-height-normal);
  }

  .project-arrow {
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateX(-8px);
    transition: all var(--transition-fast);
  }

  .project:hover .project-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Footer */
  .page-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    background: none;
    transition: color var(--transition-fast);
  }

  .github-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .project {
      grid-template-columns: 2rem 1fr auto;
      gap: var(--space-4);
      padding: var(--space-5) 0;
    }

    .project-name {
      font-size: var(--font-size-lg);
    }

    .project-arrow {
      opacity: 0.5;
      transform: translateX(0);
    }
  }
</style>
