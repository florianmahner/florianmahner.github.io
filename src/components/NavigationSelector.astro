---
/**
 * Navigation Mode Selector (Dev Mode Only)
 *
 * Floating panel to switch between navigation layouts:
 * - floating-icon: Fixed top nav bar
 * - minimal: Left sidebar navigation
 * - inline: Nav inline with content header
 */

const navModes = [
  {
    id: 'floating',
    name: 'Floating Pill',
    description: 'Safari-style floating nav bar',
  },
  {
    id: 'sidebar',
    name: 'Left Sidebar',
    description: 'Sidebar next to content',
  },
  {
    id: 'inline',
    name: 'Inline Header',
    description: 'Simple header navigation',
  },
];
---

<div class="nav-selector" id="nav-selector">
  <button class="nav-selector-toggle" aria-label="Toggle navigation selector">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    <span class="current-nav-name">Top Nav</span>
  </button>

  <div class="nav-selector-panel">
    <div class="nav-selector-header">
      <span>Navigation Layout</span>
    </div>
    <div class="nav-selector-options">
      {navModes.map(mode => (
        <button
          class="nav-option"
          data-nav-mode={mode.id}
        >
          <span class="nav-option-name">{mode.name}</span>
          <span class="nav-option-desc">{mode.description}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .nav-selector {
    position: fixed;
    bottom: 80px;
    right: 16px;
    z-index: 9998;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 12px;
  }

  .nav-selector-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .nav-selector-toggle:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  .current-nav-name {
    font-weight: 500;
  }

  .nav-selector-panel {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    width: 220px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s ease;
  }

  .nav-selector.open .nav-selector-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-selector-header {
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
    color: var(--color-text);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .nav-selector-options {
    padding: 6px;
  }

  .nav-option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    padding: 10px;
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s ease;
  }

  .nav-option:hover {
    background: var(--color-bg-alt);
  }

  .nav-option.active {
    background: rgba(var(--color-accent-rgb, 196, 30, 58), 0.1);
  }

  .nav-option-name {
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 2px;
  }

  .nav-option.active .nav-option-name {
    color: var(--color-accent);
  }

  .nav-option-desc {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  /* Dark mode adjustments */
  [data-theme="dark"] .nav-selector-toggle {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  [data-theme="dark"] .nav-selector-panel {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }
</style>

<script>
  const selector = document.getElementById('nav-selector');
  const toggle = selector?.querySelector('.nav-selector-toggle');
  const currentName = selector?.querySelector('.current-nav-name');
  const options = selector?.querySelectorAll('.nav-option');

  // Toggle panel
  toggle?.addEventListener('click', () => {
    selector?.classList.toggle('open');
  });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (selector && !selector.contains(e.target as Node)) {
      selector.classList.remove('open');
    }
  });

  // Get stored nav mode
  function getStoredNavMode(): string {
    return localStorage.getItem('nav-mode') || 'floating-icon';
  }

  // Apply nav mode
  function applyNavMode(mode: string) {
    const html = document.documentElement;
    const body = document.body;

    // Set data attribute for CSS
    html.setAttribute('data-nav-mode', mode);
    body.setAttribute('data-nav-mode', mode);

    // Store preference
    localStorage.setItem('nav-mode', mode);

    // Update button states
    options?.forEach(opt => {
      const optMode = (opt as HTMLElement).dataset.navMode;
      opt.classList.toggle('active', optMode === mode);
    });

    // Update current name display
    const modeNames: Record<string, string> = {
      'floating': 'Floating Pill',
      'sidebar': 'Left Sidebar',
      'inline': 'Inline Header',
    };
    if (currentName) {
      currentName.textContent = modeNames[mode] || mode;
    }
  }

  // Handle option clicks
  options?.forEach(opt => {
    opt.addEventListener('click', () => {
      const mode = (opt as HTMLElement).dataset.navMode;
      if (mode) {
        applyNavMode(mode);
        selector?.classList.remove('open');
      }
    });
  });

  // Initialize with stored mode
  const storedMode = getStoredNavMode();
  applyNavMode(storedMode);
</script>
