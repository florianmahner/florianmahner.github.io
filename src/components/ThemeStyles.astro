---
/**
 * Theme Styles Component
 * Generates CSS custom properties from config
 * Include this in your <head> to apply theme customization
 *
 * In dev mode: loads ALL fonts for typography preset switching
 * In production: loads only the configured fonts
 */
import { config } from '../config';
import { getAllFontsUrl, getPreset, DEFAULT_PRESET_ID } from '../lib/typography-presets';

const { theme } = config;
const isDev = import.meta.env.DEV;

// In dev mode, load all fonts for preset switching
// In production, load only the configured fonts
let fontsUrl: string;

if (isDev) {
  // Load all fonts for all presets
  fontsUrl = getAllFontsUrl();
} else {
  // Production: only load configured fonts
  const fonts = Object.values(theme.fonts).filter((v, i, a) => a.indexOf(v) === i);
  fontsUrl = `https://fonts.googleapis.com/css2?${fonts.map(f => `family=${f.replace(/ /g, '+')}:wght@300;400;500;600;700`).join('&')}&display=swap`;
}

// Get default preset for initial styles
const defaultPreset = getPreset(DEFAULT_PRESET_ID);
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href={fontsUrl} rel="stylesheet" />

<style define:vars={{
  fontBody: theme.fonts.body,
  fontHeading: theme.fonts.heading,
  fontUi: theme.fonts.ui,
  fontMono: theme.fonts.mono,
}}>
  :root {
    /* Fonts from config (can be overridden by theme selector) */
    --font-body: var(--fontBody), Georgia, serif;
    --font-heading: var(--fontHeading), Georgia, serif;
    --font-ui: var(--fontUi), system-ui, sans-serif;
    --font-mono: var(--fontMono), 'SF Mono', monospace;

    /* Typography style properties (for theme switching) */
    --heading-style: normal;
    --heading-weight: 400;
    --body-weight: 400;
  }

  /* Apply heading style from theme */
  h1, h2, h3, h4, h5, h6 {
    font-style: var(--heading-style);
    font-weight: var(--heading-weight);
  }

  /* Apply body weight from theme */
  body {
    font-weight: var(--body-weight);
  }
</style>
