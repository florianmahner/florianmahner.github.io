---
layout: base.njk
title: Florian P. Mahner
---

<!-- Hero -->
<section class="hero" id="top">
  <h1 class="hero-name reveal">Florian P<span class="accent-dot">.</span><br>Mahner</h1>
  <div class="affiliations reveal">
    {% for aff in site.affiliations %}
    <div class="affiliation">
      <div class="affiliation-name"><a href="{{ aff.url }}" target="_blank" rel="noopener noreferrer">{{ aff.name }}</a></div>
    </div>
    {% endfor %}
  </div>
  <hr class="hero-rule reveal">
</section>

<!-- 01 About -->
<section class="section" id="about">
  <div class="section-label"><span class="section-name">About</span><hr class="section-rule"></div>
  <div class="section-content reveal">
    <p class="about-text">
      I am a PhD Candidate at the <a href="https://hebartlab.com/" target="_blank" rel="noopener noreferrer">Max Planck Research Group Vision and Computational Cognition</a> supervised by <a href="http://martin-hebart.de" target="_blank" rel="noopener noreferrer">Martin Hebart</a>.
    </p>
    <p class="about-detail">
      My work primarily focuses on representation learning in humans and machines. I combine computational modeling and machine learning with insights from cognitive science to understand the similarities and differences between human and artificial systems. I mostly work on vision, but also use insights from language and other domains.
    </p>
    <p class="about-detail">
      I am particularly interested in interpretable alignment of representations and how to use insights from cognitive science to improve machine learning models and vice versa. If you are interested in collaborating, feel free to reach out.
    </p>
  </div>
</section>

<!-- 02 Background -->
<section class="section" id="background">
  <div class="section-label"><span class="section-name">Background</span><hr class="section-rule"></div>
  <div class="section-content reveal">
    {% for edu in education %}
    <div class="edu-item">
      <div class="edu-year">{{ edu.startYear }}&ndash;{{ edu.endYear }}</div>
      <div class="edu-content">
        <strong>{{ edu.degree }} in {{ edu.field }}</strong>
        <span class="edu-place"><a href="{{ edu.institutionUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.institution }}</a></span>
        {% if edu.grade %}<span class="edu-detail">{{ edu.grade }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- 03 Selected Publications -->
<section class="section" id="publications">
  <div class="section-label"><span class="section-name">Selected Publications</span><hr class="section-rule"></div>
  <div class="section-content reveal">
    {% for pub in publications %}
      {% if pub.selected %}
      <div class="pub-row">
        <div class="pub-col-year">{{ pub.year }}</div>
        <div class="pub-col-main">
          <div class="pub-title"><a href="{{ pub.pdf or pub.html or '#' }}" {% if pub.pdf or pub.html %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ pub.title }}</a></div>
          <div class="pub-venue">{{ pub.venue }}</div>
          <div class="pub-authors">{{ pub.authors | highlightAuthor(site.highlightAuthor) | safe }}</div>
          <div class="pub-links">
            {% if pub.pdf %}<a href="{{ pub.pdf }}" target="_blank" rel="noopener noreferrer">Paper</a>{% endif %}
            {% if pub.html %}<a href="{{ pub.html }}" target="_blank" rel="noopener noreferrer">Web</a>{% endif %}
            {% if pub.code %}<a href="{{ pub.code }}" target="_blank" rel="noopener noreferrer">Code</a>{% endif %}
          </div>
        </div>
      </div>
      {% endif %}
    {% endfor %}

    <button class="view-all-toggle" id="toggle-publications" aria-expanded="false" aria-controls="all-publications">View all publications &darr;</button>

    <div id="all-publications" class="expanded-publications" hidden>
      {% for pub in publications %}
        {% if not pub.selected %}
        <div class="pub-row">
          <div class="pub-col-year">{{ pub.year }}</div>
          <div class="pub-col-main">
            <div class="pub-title"><a href="{{ pub.pdf or pub.html or '#' }}" {% if pub.pdf or pub.html %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ pub.title }}</a></div>
            <div class="pub-venue">{{ pub.venue }}</div>
            <div class="pub-authors">{{ pub.authors | highlightAuthor(site.highlightAuthor) | safe }}</div>
            <div class="pub-links">
              {% if pub.pdf %}<a href="{{ pub.pdf }}" target="_blank" rel="noopener noreferrer">Paper</a>{% endif %}
              {% if pub.html %}<a href="{{ pub.html }}" target="_blank" rel="noopener noreferrer">Web</a>{% endif %}
              {% if pub.code %}<a href="{{ pub.code }}" target="_blank" rel="noopener noreferrer">Code</a>{% endif %}
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- 04 Open Source -->
<section class="section" id="code">
  <div class="section-label"><span class="section-name">Open Source</span><hr class="section-rule"></div>
  <div class="section-content reveal">
    {% for repo in repos %}
    <div class="oss-row">
      <div class="oss-lang">{{ repo.language }}</div>
      <div class="oss-body">
        <div class="oss-name"><a href="{{ repo.url }}" target="_blank" rel="noopener noreferrer">{{ repo.name }}</a></div>
        <div class="oss-desc">{{ repo.description }}</div>
        {% if repo.stars > 0 or repo.forks > 0 %}
        <div class="oss-meta">
          {% if repo.stars > 0 %}{{ repo.stars }} stars{% endif %}
          {% if repo.stars > 0 and repo.forks > 0 %} &middot; {% endif %}
          {% if repo.forks > 0 %}{{ repo.forks }} forks{% endif %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}

    <p class="view-all"><a href="https://github.com/{{ site.social.github }}" target="_blank" rel="noopener noreferrer">View all on GitHub &rarr;</a></p>
  </div>
</section>

<!-- 05 Tools -->
<section class="section" id="tools">
  <div class="section-label"><span class="section-name">Tools</span><hr class="section-rule"></div>
  <div class="section-content reveal">
    <div class="tools-grid">
      {% for tool in tools.tools %}
      <a href="{{ tool.url }}" class="tool-chip" target="_blank" rel="noopener noreferrer">
        <span class="tool-name">{{ tool.name }}</span>
        <span class="tool-desc">{{ tool.description }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

