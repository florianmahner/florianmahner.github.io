---
layout: base.njk
title: Florian P. Mahner
---

<!-- Hero -->
<section class="hero" id="top">
  <h1 class="hero-name reveal">Florian P<span class="accent-dot">.</span><br>Mahner</h1>
</section>

<!-- 01 About -->
<section class="section" id="about">
  <div class="section-label"><span class="section-name">About</span><hr class="section-rule"></div>
  <div class="section-content about-content reveal">
    {% mdfile "about" %}
  </div>
</section>

<!-- 02 Background -->
<section class="section" id="background">
  <div class="section-label"><span class="section-name">Background</span><hr class="section-rule"></div>
  <div class="section-content reveal reveal-stagger">
    {% for edu in education %}
    <div class="edu-item">
      <div class="edu-year">{{ edu.startYear }}&ndash;{{ edu.endYear }}</div>
      <div class="edu-content">
        <strong>{{ edu.degree }} in {{ edu.field }}</strong>
        <span class="edu-place"><a href="{{ edu.institutionUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.institution }}</a></span>
        {% if edu.grade %}<span class="edu-detail">{{ edu.grade }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- 03 Selected Publications -->
<section class="section" id="publications">
  <div class="section-label"><span class="section-name">Selected Publications</span><hr class="section-rule"></div>
  <div class="section-content reveal reveal-stagger">
    {% for pub in publications %}
      {% if pub.selected %}
      <div class="pub-row">
        <div class="pub-col-year">{{ pub.year }}</div>
        <div class="pub-col-main">
          <div class="pub-title"><a href="{{ pub.pdf or pub.html or '#' }}" {% if pub.pdf or pub.html %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ pub.title }}</a></div>
          <div class="pub-venue">{{ pub.venue }}</div>
          <div class="pub-authors">{{ pub.authors | highlightAuthor(site.highlightAuthor) | safe }}</div>
          <div class="pub-links">
            {% if pub.pdf %}<a href="{{ pub.pdf }}" target="_blank" rel="noopener noreferrer">Paper</a>{% endif %}
            {% if pub.html %}<a href="{{ pub.html }}" target="_blank" rel="noopener noreferrer">Web</a>{% endif %}
            {% if pub.code %}<a href="{{ pub.code }}" target="_blank" rel="noopener noreferrer">Code</a>{% endif %}
          </div>
        </div>
      </div>
      {% endif %}
    {% endfor %}

    <button class="view-all-toggle" id="toggle-publications" aria-expanded="false" aria-controls="all-publications">View all publications &darr;</button>

    <div id="all-publications" class="expanded-publications" hidden>
      {% for pub in publications %}
        {% if not pub.selected %}
        <div class="pub-row">
          <div class="pub-col-year">{{ pub.year }}</div>
          <div class="pub-col-main">
            <div class="pub-title"><a href="{{ pub.pdf or pub.html or '#' }}" {% if pub.pdf or pub.html %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ pub.title }}</a></div>
            <div class="pub-venue">{{ pub.venue }}</div>
            <div class="pub-authors">{{ pub.authors | highlightAuthor(site.highlightAuthor) | safe }}</div>
            <div class="pub-links">
              {% if pub.pdf %}<a href="{{ pub.pdf }}" target="_blank" rel="noopener noreferrer">Paper</a>{% endif %}
              {% if pub.html %}<a href="{{ pub.html }}" target="_blank" rel="noopener noreferrer">Web</a>{% endif %}
              {% if pub.code %}<a href="{{ pub.code }}" target="_blank" rel="noopener noreferrer">Code</a>{% endif %}
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- 04 Tools -->
<section class="section" id="tools">
  <div class="section-label"><span class="section-name">Tools</span><hr class="section-rule"></div>
  <div class="section-content reveal">
    <div class="tools-grid">
      {% for tool in tools.tools %}
      <a href="{{ tool.url }}" class="tool-chip" target="_blank" rel="noopener noreferrer">
        <span class="tool-name">{{ tool.name }}</span>
        <span class="tool-desc">{{ tool.description }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

