---
layout: base.njk
title: Florian P. Mahner
---
{% import "pub-row.njk" as pub_row %}
{% import "icons.njk" as icons %}
{% set NEWS_VISIBLE = 4 %}

{# One news entry plus a year heading whenever the year changes. #}
{% macro newsItems(items, prevYear) %}
{%- set last = prevYear -%}
{%- for item in items -%}
  {%- set y = item.date | yearOf -%}
  {%- if y != last %}<p class="news-year mono">{{ y }}</p>{% set last = y %}{% endif %}
  <p class="news-item"><strong>{{ item.date | monthName }}:</strong> {{ item.text | newsText | safe }}</p>
{%- endfor -%}
{% endmacro %}

<main class="page" id="top">

  <div class="stage" id="stage" aria-hidden="true"></div>

  <div class="name-row" data-flow="hero">
    <h1 class="hero-name reveal" id="name">Florian P<span class="accent-dot">.</span> Mahner</h1>
    <div class="name-links">{{ icons.socialIcons(site) }}</div>
  </div>

  <div class="grid hero" data-flow="hero">
    <section class="span-8 about reveal" aria-labelledby="name">
      {% mdfile "about" %}
    </section>

    {% if news and news.length %}
    <aside class="card news span-4 reveal" aria-labelledby="news-heading">
      <h2 class="card-bar mono" id="news-heading">news.log</h2>
      {# all news in one list that scrolls inside the card #}
      <div class="news-list" tabindex="0">
        {{ newsItems(news, "") }}
      </div>
    </aside>
    {% endif %}
  </div>

  {% set selected = publications | selectattr("selected") %}
  {% set rest = publications | rejectattr("selected") %}
  <section class="grid block" aria-labelledby="publications-heading" data-flow="pubs">
    <h2 class="block-heading span-12" id="publications-heading">Selected publications</h2>
    <div class="swipe">
      {% for pub in selected %}{{ pub_row.pubRow(pub, site.highlightAuthor) }}{% endfor %}
    </div>
    {# the other papers: hidden until asked for, then a row of the same cards that scrolls sideways #}
    {% if rest.length %}
    <div class="pub-more span-12" id="all-publications" tabindex="0" aria-label="More publications" hidden>
      {% for pub in rest %}{{ pub_row.pubRow(pub, site.highlightAuthor) }}{% endfor %}
    </div>
    {% endif %}
    <p class="block-foot span-12 mono">
      <span class="foot-links">{% if rest.length %}<button class="text-button" id="toggle-publications" type="button" aria-expanded="false" aria-controls="all-publications">show more</button>{% endif %}
      {% if site.social.scholar %}<a class="pub-scholar" href="{{ site.social.scholar }}" target="_blank" rel="noopener noreferrer">Google Scholar</a>{% endif %}</span>
      <span>* equal contribution</span>
    </p>
  </section>

  <section class="grid block" aria-labelledby="background-heading" data-flow="bg">
    <h2 class="block-heading span-12" id="background-heading">Background</h2>
    <div class="swipe">
      {% for edu in education %}
      <div class="card edu-card lift reveal">
        <p class="edu-years mono">{% if edu.startLabel %}{{ edu.startLabel }}{% else %}{{ edu.startYear }}–{{ edu.endYear }}{% endif %}</p>
        <h3 class="edu-degree">{{ edu.degree }} {{ edu.field }}</h3>
        <p class="edu-meta">{% if edu.group %}<a href="{{ edu.groupUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.group }}</a>, {% endif %}<a href="{{ edu.institutionUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.institution }}</a>{% if edu.institution2 %} and <a href="{{ edu.institution2Url }}" target="_blank" rel="noopener noreferrer">{{ edu.institution2 }}</a>{% endif %}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <footer class="footer" data-flow="footer">
    <p class="mono">&copy; {% year %} {{ site.fullName }}</p>
  </footer>
</main>
