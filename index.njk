---
layout: base.njk
title: Florian P. Mahner
---
{% import "pub-row.njk" as pub_row %}

<!-- Hero -->
<section class="hero" id="top">
  <h1 class="hero-name reveal">Florian P<span class="accent-dot">.</span><br>Mahner</h1>
</section>

<!-- 01 About -->
<section class="section" id="about">
  <div class="section-label"><span class="section-name">About</span><hr class="section-rule"></div>
  <div class="section-content about-content reveal">
    {% mdfile "about" %}
  </div>
</section>

<!-- 02 Academic Background -->
<section class="section" id="background">
  <div class="section-label"><span class="section-name">Academic Background</span><hr class="section-rule"></div>
  <div class="section-content reveal reveal-stagger">
    {% for edu in education %}
    <div class="edu-item">
      <div class="edu-content">
        <span class="edu-head"><span class="edu-year">{% if edu.startLabel %}{{ edu.startLabel }}{% else %}{{ edu.startYear }}&ndash;{{ edu.endYear }}{% endif %}</span><span class="edu-degree">{{ edu.degree }} {{ edu.field }}</span></span>
        {# Affiliation line: group, institution(s), country — one running line. #}
        <span class="edu-meta">{% if edu.group %}<a href="{{ edu.groupUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.group }}</a>, {% endif %}<a href="{{ edu.institutionUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.institution }}</a>{% if edu.institution2 %} &amp; <a href="{{ edu.institution2Url }}" target="_blank" rel="noopener noreferrer">{{ edu.institution2 }}</a>{% endif %}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- 03 Selected Publications -->
<section class="section" id="publications">
  <div class="section-label"><span class="section-name">Selected Publications</span><hr class="section-rule"></div>
  <div class="section-content reveal reveal-stagger">
    {% for pub in publications | selectattr("selected") %}
      {{ pub_row.pubRow(pub, site.highlightAuthor) }}
    {% endfor %}

    <button class="view-all-toggle" id="toggle-publications" aria-expanded="false" aria-controls="all-publications">View all publications &darr;</button>

    <div id="all-publications" class="expanded-publications" hidden>
      {% for pub in publications | rejectattr("selected") %}
        {{ pub_row.pubRow(pub, site.highlightAuthor) }}
      {% endfor %}
    </div>
  </div>
</section>

{# 04 Tools — disabled. Data lives in _data/tools.json and the .tool-* styles
   are still in css/style.css; uncomment this block to bring the section back.
   Remember to re-add the Tools entry to the nav in _includes/base.njk.

<section class="section" id="tools">
  <div class="section-label"><span class="section-name">Tools</span><hr class="section-rule"></div>
  <div class="section-content reveal">
    <div class="tools-grid">
      {% for tool in tools.tools %}
      <a href="{{ tool.url }}" class="tool-chip" target="_blank" rel="noopener noreferrer">
        <span class="tool-name">{{ tool.name }}</span>
        <span class="tool-desc">{{ tool.description }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
#}

