---
layout: base.njk
title: Florian P. Mahner
---
{% import "pub-card.njk" as card %}

<header class="hero">
  <div class="hero-dots" aria-hidden="true"></div>
  <div class="hero-stripe" aria-hidden="true"></div>
  <svg class="hero-ring" aria-hidden="true" viewBox="0 0 200 200">
    <circle class="ring-disc" cx="100" cy="100" r="100"/>
    <path class="ring-half" d="M100 0 A100 100 0 0 1 100 200 Z"/>
    <circle class="ring-eye" cx="100" cy="100" r="34"/>
  </svg>
  <nav class="profiles" aria-label="Profiles">
    {% if site.social.github %}<a href="https://github.com/{{ site.social.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>{% endif %}
    {% if site.social.scholar %}<a href="{{ site.social.scholar }}" target="_blank" rel="noopener noreferrer">Scholar</a>{% endif %}
    {% if site.social.linkedin %}<a href="https://www.linkedin.com/in/{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>{% endif %}
    {% if site.social.orcid %}<a href="https://orcid.org/{{ site.social.orcid }}" target="_blank" rel="noopener noreferrer">ORCID</a>{% endif %}
    <a href="mailto:{{ site.email }}">Email</a>
  </nav>
  <h1 class="hero-name">{{ site.name.first }} {{ site.name.middle }} <br>{{ site.name.last }}</h1>
</header>

<main>
  <div class="intro">
    <section class="about" id="about" aria-label="About">
      {% mdfile "about" %}
    </section>

    {% if news and news.length %}
    <section class="news" id="news" aria-labelledby="news-heading">
      <div class="news-in">
        <h2 class="heading news-heading" id="news-heading">News</h2>
        {# every item sits in one list that scrolls inside the panel #}
        <div class="news-list" tabindex="0" role="group" aria-labelledby="news-heading">
          {%- set last = "" -%}
          {%- for item in news -%}
          {%- set y = item.date | yearOf -%}
          {%- if y != last %}
          <p class="news-year">{{ y }}</p>{% set last = y %}{% endif %}
          <p class="news-item"><span class="news-when">{{ item.date | monthName | truncate(3, true, "") }}</span><span>{{ item.text | mdInline | safe }}</span></p>
          {%- endfor %}
        </div>
      </div>
    </section>
    {% endif %}
  </div>

  {% set selected = publications | selectattr("selected") %}
  {# after the selected three: the other journal papers; conference papers are left to Google Scholar #}
  {% set rest = publications | rejectattr("selected") | rejectattr("conference") %}
  <section class="pubs" id="publications" aria-labelledby="publications-heading">
    <h2 class="heading" id="publications-heading">Selected publications</h2>
    {# one sideways row holding every paper shown; the next one peeks in at
       the right edge, so the row reads as something to scroll #}
    <ul class="cards" id="cards" aria-label="Publications">
      {% for pub in selected %}{{ card.pubCard(pub, site.highlightAuthor, 0) }}{% endfor %}
      {% for pub in rest %}{{ card.pubCard(pub, site.highlightAuthor, loop.index0) }}{% endfor %}
    </ul>
    <p class="pubs-foot">
      {% if site.social.scholar %}<a href="{{ site.social.scholar }}" target="_blank" rel="noopener noreferrer">Google Scholar</a>{% endif %}
      <span>* equal contribution</span>
    </p>
  </section>

  <section class="background" id="background" aria-labelledby="background-heading">
    <h2 class="heading" id="background-heading">Background</h2>
    <ul class="bands">
      {% for edu in education %}
      <li class="band">
        <p class="band-years">{% if edu.startLabel %}{{ edu.startLabel }}{% else %}{{ edu.startYear }}–{{ edu.endYear }}{% endif %}</p>
        <h3 class="band-role">{{ edu.degree }} {{ edu.field }}</h3>
        <p class="band-place">{% if edu.group %}<a href="{{ edu.groupUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.group }}</a>, {% endif %}<a href="{{ edu.institutionUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.institution }}</a>{% if edu.institution2 %} and <a href="{{ edu.institution2Url }}" target="_blank" rel="noopener noreferrer">{{ edu.institution2 }}</a>{% endif %}</p>
      </li>
      {% endfor %}
    </ul>
  </section>
</main>

<footer class="footer">
  <p>&copy; {% year %} {{ site.fullName }}</p>
</footer>
