{% import "icons.njk" as icons %}
{%- set svg = 'width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"' -%}
{# Selected papers, with the Nature Machine Intelligence paper leading. #}
{% set lead = [] %}{% set others = [] %}
{% for p in publications | selectattr("selected") %}{% if "Nature Machine Intelligence" in p.venue %}{% set _ = lead.push(p) %}{% else %}{% set _ = others.push(p) %}{% endif %}{% endfor %}
{% set selected = lead.concat(others) %}
{% set rest = publications | rejectattr("selected") %}
{# About, split into its paragraphs so each can be its own page/column. #}
{% set aboutHtml %}{% mdfile "about" %}{% endset %}
{% set paras = aboutHtml | trim | replace("</p>\n<p>", "</p>\u0000<p>") %}
{% set paras = paras.split("\u0000") %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.fullName }}</title>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#eeeff1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preload" href="/fonts/inter-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/lenis/lenis.css">
  <link rel="stylesheet" href="/css/world.css">
  <script type="importmap">{"imports":{
    "three": "/vendor/three/three.module.min.js",
    "three/addons/": "/vendor/three/addons/",
    "gsap": "/vendor/gsap/index.js",
    "gsap/ScrollTrigger": "/vendor/gsap/ScrollTrigger.js",
    "gsap/SplitText": "/vendor/gsap/SplitText.js",
    "lenis": "/vendor/lenis/lenis.mjs"
  }}</script>
  <script>
    // Motion only when the reader allows it; otherwise this is a plain page.
    // While the 3D view boots, text that will animate in waits hidden; if the
    // script never starts, it shows after 3 s anyway.
    (function () {
      var r = document.documentElement;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      r.classList.add('world', 'world-boot');
      setTimeout(function () { if (!r.classList.contains('world-ready')) r.classList.remove('world', 'world-boot'); }, 3000);
    })();
  </script>
  <script type="module" src="/js/world/app.js"></script>
</head>
<body>
<header class="w-top">
  <h1 class="w-name"><a href="#top">Florian P<span class="accent-dot">.</span> Mahner</a></h1>
  <nav class="name-links" aria-label="Contact">{{ icons.socialIcons(site) }}</nav>
  <a class="mono view-switch w-switch" href="/">classic view</a>
</header>

<main id="top">
  <section class="ch ch-about" data-ch="about" aria-label="About">
    {# page 1: the opening paragraph alone #}
    <div class="pg pg-intro" data-page><div class="w-lead" data-lines>{{ paras[0] | safe }}</div></div>

    {# page 2 (desktop: held while research shows first, then news.log slides in;
       phones: three pages, one per block) #}
    <div class="pg pg-research">
      <div class="w-research">
        <div class="w-sub" data-page data-lines>{{ paras[1] | safe }}</div>
        <div class="w-sub" data-page data-lines>{% for p in paras.slice(2) %}{{ p | safe }}{% endfor %}</div>
      </div>
      {% if news and news.length %}
      <div class="w-col-news" data-page>
        <aside class="w-news" aria-labelledby="news-heading">
          <h2 class="mono w-news-label" id="news-heading">news.log</h2>
          <div class="news-list" data-lenis-prevent tabindex="0">
            {% set last = "" %}
            {% for item in news %}
              {% set y = item.date | yearOf %}
              {% if y != last %}<p class="news-year mono">{{ y }}</p>{% set last = y %}{% endif %}
              <p class="news-item"><strong>{{ item.date | monthName }}:</strong> {{ item.text | newsText | safe }}</p>
            {% endfor %}
          </div>
        </aside>
      </div>
      {% endif %}
    </div>
  </section>

  <section class="ch ch-pubs" data-ch="pubs" aria-labelledby="publications-heading">
    {% macro paper(pub, idx, svg, site, page) %}
      <article class="w-pub" data-pub="{{ idx }}"{% if page %} data-page{% endif %}>
        <p class="pub-venue mono">{{ pub.venue }} · {{ pub.year }}</p>
        <h3 class="pub-title">{{ pub.title }}</h3>
        <p class="pub-authors">{{ pub.authors | highlightAuthor(site.highlightAuthor) | safe }}</p>
        <p class="w-links">
          {%- if pub.pdf %}<a class="pub-icon" href="{{ pub.pdf }}" target="_blank" rel="noopener noreferrer" aria-label="PDF of {{ pub.title }}" title="PDF"><svg {{ svg | safe }}><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg></a>{% endif -%}
          {%- if pub.html %}<a class="pub-icon" href="{{ pub.html }}" target="_blank" rel="noopener noreferrer" aria-label="Web page for {{ pub.title }}" title="Web"><svg {{ svg | safe }}><path d="M10 14L20 4"/><path d="M15 4h5v5"/><path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"/></svg></a>{% endif -%}
          {%- if pub.code %}<a class="pub-icon" href="{{ pub.code }}" target="_blank" rel="noopener noreferrer" aria-label="Code for {{ pub.title }}" title="Code"><svg {{ svg | safe }}><path d="M8 7l-5 5 5 5"/><path d="M16 7l5 5-5 5"/></svg></a>{% endif -%}
        </p>
      </article>
    {% endmacro %}
    {# desktop: held while the papers slide past sideways; phones: one page each #}
    <div class="w-hpin">
      <h2 class="block-heading" id="publications-heading" data-chars>Selected publications</h2>
      <div class="w-track">
        {% for pub in selected %}{{ paper(pub, loop.index0, svg, site, true) }}{% endfor %}
      </div>
      <p class="w-note mono">
        <span class="foot-links">{% if rest.length %}<button class="text-button" id="toggle-publications" type="button" aria-expanded="false" aria-controls="all-publications">show more</button>{% endif %}
        {% if site.social.scholar %}<a class="pub-scholar" href="{{ site.social.scholar }}" target="_blank" rel="noopener noreferrer">Google Scholar</a>{% endif %}</span>
        <span>* equal contribution</span>
      </p>
    </div>
    <div class="w-more" id="all-publications" hidden>
      {% for pub in rest %}{{ paper(pub, selected.length + loop.index0, svg, site, false) }}{% endfor %}
    </div>
  </section>
  <div class="w-paper" id="w-paper" role="dialog" aria-modal="false" aria-label="Publication" hidden>
    <button type="button" class="w-close w-paper-close" aria-label="Close"></button>
    <p class="w-paper-venue mono"></p>
    <div class="w-paper-body"></div>
  </div>
  <div class="w-leader" aria-hidden="true"></div>

  <section class="ch ch-bg" data-ch="bg" data-page aria-labelledby="background-heading">
    <h2 class="block-heading" id="background-heading" data-chars>Background</h2>
    <div class="w-edus">
      {% for edu in education %}
      <div class="w-edu">
        <p class="edu-years mono">{% if edu.startLabel %}{{ edu.startLabel }}{% else %}{{ edu.startYear }}–{{ edu.endYear }}{% endif %}</p>
        <h3 class="edu-degree">{{ edu.degree }} {{ edu.field }}</h3>
        <p class="edu-meta">{% if edu.group %}<a href="{{ edu.groupUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.group }}</a>, {% endif %}<a href="{{ edu.institutionUrl }}" target="_blank" rel="noopener noreferrer">{{ edu.institution }}</a>{% if edu.institution2 %} and <a href="{{ edu.institution2Url }}" target="_blank" rel="noopener noreferrer">{{ edu.institution2 }}</a>{% endif %}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <footer class="ch ch-end" data-ch="end" data-page>
    <div class="name-links">{{ icons.socialIcons(site) }}</div>
    <p class="mono">&copy; {% year %} {{ site.fullName }}</p>
  </footer>
</main>
</body>
</html>
